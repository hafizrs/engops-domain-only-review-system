AI_SERVICE_SECRET=dev-ai-secret-change-me

# --- Demo: local Ollama (free, no paid API) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# ~4GB GPU: llama3.2:3b | CPU-only: llama3.2:1b or phi3:mini
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_FALLBACK_ON_ERROR=true
OLLAMA_NUM_GPU=-1
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=1024
OLLAMA_NUM_PREDICT_INSIGHTS=1536

# --- Production: Azure OpenAI (paid — set LLM_PROVIDER=azure) ---
# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

LOG_LEVEL=INFO
